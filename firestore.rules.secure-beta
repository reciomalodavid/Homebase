rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Beta-first rollout:
    // - BETA_* homes use strict authenticated device membership.
    // - Production keeps its current authenticated temporary access window while
    //   Beta is validated. Production will be migrated only after explicit approval.

    function signedIn() {
      return request.auth != null;
    }

    function isBetaHome(homeId) {
      return homeId.matches('BETA_.*');
    }

    function productionWindowOpen() {
      return request.time < timestamp.date(2026, 12, 31);
    }

    function legacyProductionAccess(homeId) {
      return signedIn()
        && !isBetaHome(homeId)
        && productionWindowOpen();
    }

    function hasMemberList(data) {
      return data.authorizedUids is list;
    }

    function memberOfBetaHome(homeId) {
      return signedIn()
        && isBetaHome(homeId)
        && exists(/databases/$(database)/documents/homebaseSyncs/$(homeId))
        && get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids is list
        && request.auth.uid in get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids;
    }

    function isCurrentMember() {
      return signedIn()
        && hasMemberList(resource.data)
        && request.auth.uid in resource.data.authorizedUids;
    }

    function createsOwnHome() {
      return signedIn()
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.size() == 1
        && request.resource.data.authorizedUids[0] == request.auth.uid;
    }

    function keepsCurrentUserAuthorized() {
      return hasMemberList(request.resource.data)
        && request.auth.uid in request.resource.data.authorizedUids;
    }

    // Atomic Beta pairing: the invite claim and the home membership update are
    // committed in the same Firestore transaction. getAfter() validates the invite
    // as it will exist after that transaction, so a failed join does not consume it.
    function validClaimedInvite(homeId) {
      let token = request.resource.data.securityJoinToken;
      let invite = getAfter(/databases/$(database)/documents/homebaseDeviceInvites/$(token)).data;
      return signedIn()
        && token is string
        && invite.homeId == homeId
        && invite.claimedUid == request.auth.uid
        && invite.expiresAt > request.time;
    }

    function joinsWithoutRemovingMembers(homeId) {
      return validClaimedInvite(homeId)
        && hasMemberList(resource.data)
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids)
        && request.auth.uid in request.resource.data.authorizedUids
        && request.resource.data.authorizedUids.size() <= resource.data.authorizedUids.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorizedUids',
          'securityJoinToken',
          'securityVersion',
          'securityUpdatedAt'
        ]);
    }

    match /homebaseSyncs/{homeId} {
      // Production: preserve current authenticated access during Beta validation.
      allow read, write: if legacyProductionAccess(homeId);

      // Beta: strict permanent device-membership model.
      allow get: if isBetaHome(homeId) && isCurrentMember();
      allow list: if false;

      allow create: if isBetaHome(homeId) && createsOwnHome();

      allow update: if isBetaHome(homeId)
                    && ((isCurrentMember() && keepsCurrentUserAuthorized())
                        || joinsWithoutRemovingMembers(homeId));

      allow delete: if false;
    }

    // Temporary one-use pairing codes. Only Beta homes use these during this phase.
    match /homebaseDeviceInvites/{token} {
      allow get: if signedIn()
                 && resource.data.expiresAt > request.time;
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.homeId is string
                    && request.resource.data.homeId.matches('BETA_.*')
                    && memberOfBetaHome(request.resource.data.homeId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.claimedUid == null
                    && request.resource.data.expiresAt > request.time;

      allow update: if signedIn()
                    && resource.data.expiresAt > request.time
                    && resource.data.claimedUid == null
                    && request.resource.data.claimedUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'claimedUid',
                      'claimedAt'
                    ]);

      allow delete: if signedIn()
                    && (resource.data.createdByUid == request.auth.uid
                        || resource.data.claimedUid == request.auth.uid
                        || memberOfBetaHome(resource.data.homeId));
    }

    // Versioned cloud backups.
    // Beta backups inherit strict membership from BETA_<code>.
    // Production backups keep the same temporary authenticated access as production
    // sync so this Beta rollout cannot break the live recovery system.
    match /homebaseBackups/{homeId} {
      allow read, write: if false;

      match /snapshots/{snapshotId} {
        allow read, create, update, delete: if (isBetaHome(homeId) && memberOfBetaHome(homeId))
                                            || legacyProductionAccess(homeId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if (isBetaHome(homeId) && memberOfBetaHome(homeId))
                                              || legacyProductionAccess(homeId);
        }
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
