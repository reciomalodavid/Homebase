rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rollout strategy:
    // - BETA_* home documents use the permanent authenticated/device-membership model.
    // - Production home documents keep the current temporary access window until
    //   production is migrated deliberately. This prevents a Beta security rollout
    //   from breaking the live app.

    function signedIn() {
      return request.auth != null;
    }

    function isBetaHome(homeId) {
      return homeId.matches('BETA_.*');
    }

    function productionWindowOpen() {
      return request.time < timestamp.date(2026, 12, 31);
    }

    function hasMemberList(data) {
      return data.authorizedUids is list;
    }

    function memberOfHome(homeId) {
      return signedIn()
        && isBetaHome(homeId)
        && exists(/databases/$(database)/documents/homebaseSyncs/$(homeId))
        && get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids is list
        && request.auth.uid in get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids;
    }

    function isCurrentMember() {
      return signedIn()
        && hasMemberList(resource.data)
        && request.auth.uid in resource.data.authorizedUids;
    }

    function createsOwnHome() {
      return signedIn()
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.size() == 1
        && request.resource.data.authorizedUids[0] == request.auth.uid;
    }

    function keepsCurrentUserAuthorized() {
      return hasMemberList(request.resource.data)
        && request.auth.uid in request.resource.data.authorizedUids;
    }

    function validClaimedInvite(homeId) {
      let token = request.resource.data.securityJoinToken;
      return signedIn()
        && token is string
        && exists(/databases/$(database)/documents/homebaseDeviceInvites/$(token))
        && get(/databases/$(database)/documents/homebaseDeviceInvites/$(token)).data.homeId == homeId
        && get(/databases/$(database)/documents/homebaseDeviceInvites/$(token)).data.claimedUid == request.auth.uid
        && get(/databases/$(database)/documents/homebaseDeviceInvites/$(token)).data.expiresAt > request.time;
    }

    function joinsWithoutRemovingMembers(homeId) {
      return validClaimedInvite(homeId)
        && hasMemberList(resource.data)
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids)
        && request.auth.uid in request.resource.data.authorizedUids
        && request.resource.data.authorizedUids.size() <= resource.data.authorizedUids.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorizedUids',
          'securityJoinToken',
          'securityVersion',
          'securityUpdatedAt'
        ]);
    }

    match /homebaseSyncs/{homeId} {
      // Production remains on the temporary legacy rule during migration.
      // BETA_* is explicitly excluded from this rule.
      allow read, write: if !isBetaHome(homeId) && productionWindowOpen();

      // Permanent Beta security model.
      allow get: if isBetaHome(homeId) && isCurrentMember();
      allow list: if false;

      allow create: if isBetaHome(homeId) && createsOwnHome();

      allow update: if isBetaHome(homeId)
                    && ((isCurrentMember() && keepsCurrentUserAuthorized())
                        || joinsWithoutRemovingMembers(homeId));

      allow delete: if false;
    }

    match /homebaseDeviceInvites/{token} {
      allow get: if signedIn()
                 && resource.data.expiresAt > request.time;
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.homeId is string
                    && request.resource.data.homeId.matches('BETA_.*')
                    && memberOfHome(request.resource.data.homeId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.claimedUid == null
                    && request.resource.data.expiresAt > request.time;

      allow update: if signedIn()
                    && resource.data.expiresAt > request.time
                    && resource.data.claimedUid == null
                    && request.resource.data.claimedUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'claimedUid',
                      'claimedAt'
                    ]);

      allow delete: if signedIn()
                    && (resource.data.createdByUid == request.auth.uid
                        || resource.data.claimedUid == request.auth.uid
                        || memberOfHome(resource.data.homeId));
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
