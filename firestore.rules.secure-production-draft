rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasMemberList(data) {
      return data.authorizedUids is list;
    }

    function homeExists(homeId) {
      return exists(/databases/$(database)/documents/homebaseSyncs/$(homeId));
    }

    function memberOfHome(homeId) {
      return signedIn()
        && homeExists(homeId)
        && get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids is list
        && request.auth.uid in get(/databases/$(database)/documents/homebaseSyncs/$(homeId)).data.authorizedUids;
    }

    function isCurrentMember() {
      return signedIn()
        && hasMemberList(resource.data)
        && request.auth.uid in resource.data.authorizedUids;
    }

    function createsOwnHome() {
      return signedIn()
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.size() == 1
        && request.resource.data.authorizedUids[0] == request.auth.uid;
    }

    function keepsCurrentUserAuthorized() {
      return hasMemberList(request.resource.data)
        && request.auth.uid in request.resource.data.authorizedUids;
    }

    function validClaimedInvite(homeId) {
      let token = request.resource.data.securityJoinToken;
      let invite = getAfter(/databases/$(database)/documents/homebaseDeviceInvites/$(token)).data;
      return signedIn()
        && token is string
        && invite.homeId == homeId
        && invite.claimedUid == request.auth.uid
        && invite.expiresAt > request.time;
    }

    function joinsWithoutRemovingMembers(homeId) {
      return validClaimedInvite(homeId)
        && hasMemberList(resource.data)
        && hasMemberList(request.resource.data)
        && request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids)
        && request.auth.uid in request.resource.data.authorizedUids
        && request.resource.data.authorizedUids.size() <= resource.data.authorizedUids.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorizedUids',
          'securityJoinToken',
          'securityVersion',
          'securityUpdatedAt'
        ]);
    }

    match /homebaseSyncs/{homeId} {
      allow get: if isCurrentMember();
      allow list: if false;

      allow create: if createsOwnHome();

      allow update: if (isCurrentMember() && keepsCurrentUserAuthorized())
                    || joinsWithoutRemovingMembers(homeId);

      allow delete: if false;
    }

    match /homebaseDeviceInvites/{token} {
      allow get: if signedIn()
                 && resource.data.expiresAt > request.time;
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.homeId is string
                    && memberOfHome(request.resource.data.homeId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.claimedUid == null
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt < request.time + duration.value(11, 'm')
                    && request.resource.data.diff({}).affectedKeys().hasOnly([
                      'homeId',
                      'createdByUid',
                      'createdAt',
                      'expiresAt',
                      'claimedUid',
                      'securityVersion'
                    ]);

      allow update: if signedIn()
                    && resource.data.expiresAt > request.time
                    && resource.data.claimedUid == null
                    && request.resource.data.claimedUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'claimedUid',
                      'claimedAt'
                    ]);

      allow delete: if signedIn()
                    && (resource.data.createdByUid == request.auth.uid
                        || resource.data.claimedUid == request.auth.uid
                        || memberOfHome(resource.data.homeId));
    }

    match /homebaseBackups/{homeId} {
      allow read, write: if false;

      match /snapshots/{snapshotId} {
        allow read, create, update, delete: if memberOfHome(homeId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if memberOfHome(homeId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
